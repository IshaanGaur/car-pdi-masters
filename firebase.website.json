{
  "functions": {
    "source": "functions",
    "codebase": "payments"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.*.json",
      ".firebaserc*",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "*.backup-*",
      "_before-encoding-cleanup-20260930/**",
      "_favicon-backup-20260930/**",
      "_pricing-backups-20260929/**",
      "_pricing-final-backups-20260929/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "config/README*",
      "config/cms-import*.json",
      "assets/cpm-favicon-test*",
      "DEPLOY-WEBSITE.md",
      "*-CHANGELOG-*.txt",
      "*-audit-*.txt",
      "_*.ps1"
    ],
    "target": "website",
    "predeploy": [
      "node scripts/check-website.js"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|json|xml|txt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.pdf",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {"source": "/locations/delhi", "destination": "/locations/delhi.html", "type": 301},
      {"source": "/locations/delhi/", "destination": "/locations/delhi.html", "type": 301},
      {"source": "/locations/gurugram", "destination": "/locations/gurugram.html", "type": 301},
      {"source": "/locations/gurugram/", "destination": "/locations/gurugram.html", "type": 301},
      {"source": "/locations", "destination": "/site-map.html", "type": 301},
      {"source": "/locations/", "destination": "/site-map.html", "type": 301},
      {"regex": "^/(?P<dir>locations/delhi|locations/gurugram|services)/(?P<page>[a-z0-9-]+)/?$", "destination": "/:dir/:page.html", "type": 301}
    ]
  }
}
